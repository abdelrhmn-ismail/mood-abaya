<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS / Azure: requires URL Rewrite module. Routes /media/* to index.php (same as .htaccess) so Laravel can stream files and avoid 403 permission issues.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="Laravel Media" stopProcessing="true">
          <match url="^media/(.*)" ignoreCase="false" />
          <action type="Rewrite" url="index.php" appendQueryString="true" />
        </rule>
        <rule name="Imported Rule 1" stopProcessing="true">
          <match url="^(.*)/$" ignoreCase="false" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" />
          </conditions>
          <action type="Redirect" redirectType="Permanent" url="/{R:1}" />
        </rule>
        <rule name="Imported Rule 2" stopProcessing="true">
          <match url="^" ignoreCase="false" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
          </conditions>
          <action type="Rewrite" url="index.php" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
